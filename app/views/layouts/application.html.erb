<!DOCTYPE html>
<html>
  <head>
    <script>
      // Runs before any CSS paints to avoid a flash of the wrong theme.
      // The actual toggle lives in app/javascript/controllers/theme_controller.js.
      (function () {
        var stored = localStorage.getItem("theme");
        if (stored) document.documentElement.dataset.theme = stored;
      })();
    </script>
    <title>Payapp</title>
    <%= csrf_meta_tags %>
    <%# Materialize (unlayered globals wrapped in @layer materialize) must load
        before Tailwind so that layer -- which CSS ranks by first-seen order --
        registers with the lowest priority; otherwise its bare `nav`, `a`, etc.
        selectors would beat every Tailwind utility regardless of specificity. %>
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'materialize_and_charts', 'data-turbo-track': 'reload' %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!--Let browser know website is optimized for mobile-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <%= favicon_link_tag asset_path('favicon_money.ico') %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink">
    <% if user_signed_in? %>
      <%= render 'layouts/nav' %>

      <div class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 sm:px-6">
        <%= render 'layouts/flash' %>
        <%= yield %>
      </div>

      <footer class="border-t border-line bg-paper-sunken">
        <div class="mx-auto max-w-5xl px-4 py-4 text-xs text-ink-faint">
          © 2018 GOEP SOFTWARE
        </div>
      </footer>

    <% else %>
      <div class="flex flex-1 flex-col items-center justify-center px-4 py-12">
        <%= link_to root_path, class: "mb-8 flex items-center gap-2 font-display text-xl font-semibold text-ink" do %>
          <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path stroke-linecap="round" d="M9.5 15.2c.4 1 1.4 1.6 2.5 1.6 1.4 0 2.5-.8 2.5-2s-1.1-1.7-2.5-2c-1.4-.3-2.5-1-2.5-2s1.1-2 2.5-2c1.1 0 2 .5 2.5 1.4" />
            <path stroke-linecap="round" d="M12 7.3v1M12 15.7v1.2" />
          </svg>
          PayApp
        <% end %>
        <div class="w-full max-w-sm">
          <%= render 'layouts/flash' %>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
