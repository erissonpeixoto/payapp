<%= render "shared/form_errors", record: payment %>

<%= form_for(payment) do |f| %>
  <div class="mb-6">
    <%= f.label :payday, "Data do fechamento", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.date_field :payday,
        class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div class="mb-6">
    <%= f.label :status, "Status", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.select :status, Payment.statuses.keys.to_a, { include_blank: "Selecione" },
        class: "block w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div class="mb-6">
    <%= f.label :note, "Observação", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.text_field :note, class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <% if payment.persisted? && payment.expenses_fixed_not_used.any? %>
    <div class="mb-6 rounded-md border border-dashed border-accent-tint/40 bg-accent-tint/10 p-4">
      <p class="mb-2 flex items-center gap-2 text-sm font-medium text-accent">
        <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 8v5M12 16h.01" />
        </svg>
        Despesas fixas ainda não pagas
      </p>
      <div class="flex flex-wrap gap-2">
        <% payment.expenses_fixed_not_used.each do |expense| %>
          <span class="inline-flex items-center rounded-full border border-accent-tint/30 bg-paper-raised px-2.5 py-1 text-xs text-ink-soft"><%= expense.name %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset data-controller="nested-form" class="mb-6 p-0">
    <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-expense">Despesas</legend>
    <template data-nested-form-target="template">
      <%= f.fields_for :expense_payments, ExpensePayment.new, child_index: "NEW_RECORD" do |expense_payments_fields| %>
        <%= render partial: "expense_payment_fields", locals: { f: expense_payments_fields } %>
      <% end %>
    </template>
    <div class="space-y-2" data-nested-form-target="list">
      <%= f.fields_for :expense_payments, payment.expense_payments do |expense_payments_fields| %>
        <%= render partial: "expense_payment_fields", locals: { f: expense_payments_fields } %>
      <% end %>
    </div>
    <button type="button"
        class="mt-2 w-full rounded-md border border-dashed border-line-strong px-4 py-2.5 text-sm font-medium text-expense hover:bg-paper-sunken"
        data-action="nested-form#add">
      + Adicionar despesa
    </button>
  </fieldset>

  <fieldset data-controller="nested-form" class="mb-6 p-0">
    <legend class="mb-2 text-xs font-bold uppercase tracking-wide text-revenue">Receitas</legend>
    <template data-nested-form-target="template">
      <%= f.fields_for :revenue_payments, RevenuePayment.new, child_index: "NEW_RECORD" do |revenue_payments_fields| %>
        <%= render partial: "revenue_payment_fields", locals: { f: revenue_payments_fields } %>
      <% end %>
    </template>
    <div class="space-y-2" data-nested-form-target="list">
      <%= f.fields_for :revenue_payments, payment.revenue_payments do |revenue_payments_fields| %>
        <%= render partial: "revenue_payment_fields", locals: { f: revenue_payments_fields } %>
      <% end %>
    </div>
    <button type="button"
        class="mt-2 w-full rounded-md border border-dashed border-line-strong px-4 py-2.5 text-sm font-medium text-revenue hover:bg-paper-sunken"
        data-action="nested-form#add">
      + Adicionar receita
    </button>
  </fieldset>

  <div class="sticky bottom-0 flex items-center gap-3 border-t border-line bg-paper/95 py-3 backdrop-blur">
    <%= link_to "Cancelar", payments_path, class: "rounded-md border border-line-strong px-4 py-2 text-sm font-medium text-ink hover:bg-paper-sunken" %>
    <%= f.submit "Salvar fechamento", class: "flex-1 cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint sm:flex-none" %>
  </div>
<% end %>
