<p>
  <strong>Nome:</strong>
  <%= @revenue.name %>
</p>

<p>
  <strong>Fixa?</strong>
  <%= badges_boolean(@revenue.fixed) %>
</p>

<p>
  <strong>Categoria:</strong>
  <%= @revenue.try(:category).try(:name) %>
</p>

<%= link_to 'Editar', edit_revenue_path(@revenue), class: 'waves-effect waves-light btn blue-grey' %> |
<%= link_to 'Voltar', revenues_path, class: 'waves-effect waves-light btn blue-grey' %>
