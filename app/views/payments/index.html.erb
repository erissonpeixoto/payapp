<h4>Pagamentos</h4>

<%= form_tag payments_path, method: :get, class: 'row' do %>
  <div class="input-field col s12 m3">
    <%= label_tag :status_filter, 'Status', class: 'active' %>
    <%= select_tag :status_filter,
          options_for_select(Payment.statuses.keys, params[:status_filter]),
          { include_blank: 'Todos', class: 'browser-default' } %>
  </div>
  <div class="input-field col s12 m3">
    <%= label_tag :category_id, 'Categoria', class: 'active' %>
    <%= select_tag :category_id,
          options_from_collection_for_select(Category.where(user: current_user).order(:name), :id, :name, params[:category_id]),
          { include_blank: 'Todas', class: 'browser-default' } %>
  </div>
  <div class="input-field col s6 m2">
    <%= label_tag :period_start, 'De', class: 'active' %>
    <%= text_field_tag :period_start, params[:period_start], class: 'datepicker', data: { controller: 'datepicker' } %>
  </div>
  <div class="input-field col s6 m2">
    <%= label_tag :period_end, 'Até', class: 'active' %>
    <%= text_field_tag :period_end, params[:period_end], class: 'datepicker', data: { controller: 'datepicker' } %>
  </div>
  <div class="input-field col s12 m2">
    <button class="btn waves-effect waves-light" type="submit">
      Filtrar<i class="material-icons right">search</i>
    </button>
    <%= link_to 'Limpar', payments_path, class: 'btn-flat' %>
  </div>
<% end %>

<% if @payments.any? %>
  <table class="striped">
    <thead>
      <tr>
        <th width="25%">Data Pagamento</th>
        <th width="30%">Saldo Total</th>
        <th width="20%">Status</th>
        <th width="25%" colspan="3"></th>
      </tr>
    </thead>

    <tbody>
      <% @payments.each do |payment| %>
        <tr>
          <td><%= payment.payday.to_fs(:custom_datetime) %></td>
          <td><%= number_to_currency(payment.value, unit: "R$ ", separator: ",", delimiter: ".") %></td>
          <td><%= badges(payment.status) %></td>
          <td><%= link_to payment, class: 'btn-floating btn-small waves-effect waves-light blue' do %>
                <i class="material-icons">pageview</i>
              <% end %>
          </td>
          <td><%= link_to edit_payment_path(payment), class: 'btn-floating btn-small waves-effect waves-light green' do %>
                <i class="material-icons">edit</i>
              <% end %>
          </td>
          <td><%= link_to payment, data: { turbo_method: :delete, turbo_confirm: 'Tem certeza?' }, class: 'btn-floating btn-small waves-effect waves-light red' do %>
                <i class="material-icons">delete</i>
              <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h6 class="header red-text text-lighten-1 center-align">Não há registros para mostrar</h6>
<% end %>

<div class="right"><h6><strong><%= "#{"Total de registros: " + @payments.count.to_s}" %></h6></strong></div>

<%= will_paginate @payments %>

<br>

<%= link_to 'Novo Pagamento', new_payment_path, class: 'waves-effect waves-light btn' %>