<%= render "shared/form_errors", record: category %>

<%= form_for(category) do |f| %>
  <div class="mb-6">
    <%= f.label :name, "Nome", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.text_field :name, class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "Cancelar", categories_path, class: "rounded-md border border-line-strong px-4 py-2 text-sm font-medium text-ink hover:bg-paper-sunken" %>
    <%= f.submit "Salvar categoria", class: "cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint" %>
  </div>
<% end %>
