<div class="mx-auto max-w-2xl">
  <%= render "shared/back_header", title: ledger_month_label(@payment.payday), back_path: payments_path %>

  <div class="mb-6 rounded-lg border border-line bg-paper-raised p-6">
    <div class="mb-3 flex items-center justify-between">
      <%= badges(@payment.status) %>
      <p class="text-xs text-ink-faint"><%= ledger_period_label(@payment.payday) %></p>
    </div>

    <% net = payment_net(@payment) %>
    <p class="font-mono text-3xl font-semibold tabular-nums <%= net < 0 ? 'text-expense' : 'text-revenue' %>">
      <%= net < 0 ? "−" : "+" %><%= number_to_currency(net.abs, unit: "R$ ", separator: ",", delimiter: ".") %>
    </p>

    <% if @payment.note.present? %>
      <p class="mt-2 text-sm text-ink-soft"><%= @payment.note %></p>
    <% end %>

    <div class="mt-4 flex items-center gap-3">
      <%= link_to "Editar fechamento", edit_payment_path(@payment), class: "rounded-md border border-line-strong px-4 py-2 text-sm font-medium text-ink hover:bg-paper-sunken" %>
      <%= link_to "Excluir fechamento", @payment,
          data: { turbo_method: :delete, turbo_confirm: destroy_payment_confirm(@payment) },
          class: "rounded-md border border-expense-tint/40 px-4 py-2 text-sm font-medium text-expense hover:bg-expense-tint/10" %>
    </div>
  </div>

  <div class="mb-2 flex items-center justify-between">
    <h2 class="text-xs font-bold uppercase tracking-wide text-expense">Despesas</h2>
    <p class="font-mono text-xs tabular-nums text-ink-soft">
      <%= number_to_currency(@payment.expense_payments.sum(:value), unit: "R$ ", separator: ",", delimiter: ".") %>
    </p>
  </div>
  <% if @payment.expense_payments.any? %>
    <div class="mb-6 rounded-lg border border-line bg-paper-raised px-4">
      <%= render partial: "expense_payments/row", collection: @payment.expense_payments, as: :expense_payment %>
    </div>
  <% else %>
    <div class="mb-6"><%= render "shared/empty_state", title: "Nenhuma despesa neste fechamento." %></div>
  <% end %>

  <div class="mb-2 flex items-center justify-between">
    <h2 class="text-xs font-bold uppercase tracking-wide text-revenue">Receitas</h2>
    <p class="font-mono text-xs tabular-nums text-ink-soft">
      <%= number_to_currency(@payment.revenue_payments.sum(:value), unit: "R$ ", separator: ",", delimiter: ".") %>
    </p>
  </div>
  <% if @payment.revenue_payments.any? %>
    <div class="rounded-lg border border-line bg-paper-raised px-4">
      <%= render partial: "revenue_payments/row", collection: @payment.revenue_payments, as: :revenue_payment %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: "Nenhuma receita neste fechamento." %>
  <% end %>
</div>
