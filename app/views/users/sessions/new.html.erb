<div class="rounded-lg border border-line bg-paper-raised p-6 shadow-sm">
  <h1 class="mb-6 text-center font-display text-xl font-semibold text-ink">Entrar</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
    </div>

    <div class="mb-4">
      <div class="mb-1 flex items-center justify-between">
        <%= f.label :password, "Senha", class: "block text-sm font-medium text-ink" %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs font-medium text-accent hover:underline" %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password",
          class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-6">
        <label class="flex items-center gap-2 text-sm text-ink">
          <%= f.check_box :remember_me, class: "h-4 w-4 shrink-0 rounded border-line-strong text-accent focus:ring-accent" %>
          Lembrar de mim
        </label>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint" %>
  <% end %>

  <%= render "users/shared/links" %>
</div>
