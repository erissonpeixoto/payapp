<%= render "shared/form_errors", record: expense %>

<%= form_for(expense) do |f| %>
  <div class="mb-6">
    <%= f.label :name, "Nome", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.text_field :name, class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div class="mb-6">
    <%= f.label :category_id, "Categoria", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= f.select :category_id,
        options_from_collection_for_select(Category.where(user: current_user).order(:name), :id, :name, f.object.category_id),
        { include_blank: 'Selecione' },
        class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div class="mb-6">
    <label class="flex items-center gap-2 text-sm text-ink">
      <%= f.check_box :fixed, class: "h-4 w-4 rounded border-line-strong text-accent focus:ring-accent" %>
      Despesa fixa (se repete todo mês)
    </label>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "Cancelar", expenses_path, class: "rounded-md border border-line-strong px-4 py-2 text-sm font-medium text-ink hover:bg-paper-sunken" %>
    <%= f.submit "Salvar despesa", class: "cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint" %>
  </div>
<% end %>
