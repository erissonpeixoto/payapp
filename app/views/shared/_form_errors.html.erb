<% if record.errors.any? %>
  <div class="mb-4 rounded-md border border-expense-tint/40 bg-expense-tint/10 px-4 py-3 text-sm text-expense">
    <p class="font-medium"><%= pluralize(record.errors.count, "erro") %> impediram o salvamento:</p>
    <ul class="mt-1 list-disc pl-5">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
