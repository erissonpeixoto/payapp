<div class="mt-4 flex flex-col items-center gap-1.5 text-sm">
  <% if controller_name != "sessions" %>
    <%= link_to "Entrar", new_session_path(resource_name), class: "font-medium text-accent hover:underline" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Criar conta", new_registration_path(resource_name), class: "font-medium text-accent hover:underline" %>
  <% end %>
</div>
