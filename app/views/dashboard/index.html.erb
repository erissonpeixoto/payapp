<div class="mx-auto max-w-5xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="font-display text-2xl font-semibold text-ink">Dashboard</h1>
    <% if @last_user_payment.present? %>
      <%= link_to "Ver detalhes do último fechamento", @last_user_payment, class: "text-sm font-medium text-accent hover:underline" %>
    <% end %>
  </div>

  <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-line bg-paper-raised p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Salário</p>
      <p class="mt-1 font-mono text-xl tabular-nums text-ink">
        <%= number_to_currency(@salary, unit: "R$ ", separator: ",", delimiter: ".") %>
      </p>
    </div>
    <div class="rounded-lg border border-line bg-paper-raised p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Pago no mês</p>
      <p class="mt-1 font-mono text-xl tabular-nums text-expense">
        <%= number_to_currency(@total_paid, unit: "R$ ", separator: ",", delimiter: ".") %>
      </p>
    </div>
    <div class="rounded-lg border border-line bg-paper-raised p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Saldo do mês</p>
      <p class="mt-1 font-mono text-xl tabular-nums <%= @balance < 0 ? 'text-expense' : 'text-revenue' %>">
        <%= number_to_currency(@balance, unit: "R$ ", separator: ",", delimiter: ".") %>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-lg border border-line bg-paper-raised p-6">
      <h2 class="mb-4 text-sm font-semibold text-ink">Saldo do mês atual</h2>
      <% if @salary.zero? && @total_paid.zero? %>
        <%= render "shared/empty_state", title: "Sem dados para exibir ainda" %>
      <% else %>
        <div class="h-64">
          <canvas
            data-controller="chart"
            data-chart-type-value="pie"
            data-chart-labels-value="<%= @balance_chart[:labels].to_json %>"
            data-chart-data-value="<%= @balance_chart[:data].to_json %>"
          ></canvas>
        </div>
      <% end %>
    </div>

    <div class="rounded-lg border border-line bg-paper-raised p-6">
      <h2 class="mb-4 text-sm font-semibold text-ink">Despesas por categoria no mês atual</h2>
      <% if @expenses_by_category_chart[:data].empty? %>
        <%= render "shared/empty_state", title: "Nenhuma despesa paga neste fechamento" %>
      <% else %>
        <div class="h-64">
          <canvas
            data-controller="chart"
            data-chart-type-value="bar"
            data-chart-color-value="expense"
            data-chart-labels-value="<%= @expenses_by_category_chart[:labels].to_json %>"
            data-chart-data-value="<%= @expenses_by_category_chart[:data].to_json %>"
          ></canvas>
        </div>
      <% end %>
    </div>

    <div class="rounded-lg border border-line bg-paper-raised p-6 lg:col-span-2">
      <h2 class="mb-4 text-sm font-semibold text-ink">Valor pago por mês (últimos 6 meses)</h2>
      <% if @monthly_paid_chart[:data].empty? %>
        <%= render "shared/empty_state", title: "Nenhum pagamento nos últimos 6 meses" %>
      <% else %>
        <div class="h-64">
          <canvas
            data-controller="chart"
            data-chart-type-value="line"
            data-chart-color-value="accent"
            data-chart-labels-value="<%= @monthly_paid_chart[:labels].to_json %>"
            data-chart-data-value="<%= @monthly_paid_chart[:data].to_json %>"
          ></canvas>
        </div>
      <% end %>
    </div>
  </div>
</div>
