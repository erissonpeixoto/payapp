<div class="nested-fields" data-new-record="<%= f.object.new_record? %>">
  <%= f.hidden_field :_destroy %>
  <div class="row">
    <div class="input-field col s7">
      <%= f.label :expense, class: 'active' %>
      <%= f.select :expense_id,
          options_from_collection_for_select(Expense.where(user: current_user).order(:name), :id, :name, f.object.expense_id ),
          { :include_blank => 'Selecione' }, { :class => 'browser-default' } %>
    </div>
    <div class="input-field col s3">
      <%= f.label :value, class: 'active' %>
      <%= f.number_field :value, step: :any %>
    </div>
    <div class="input-field col s2">
      <button type="button" class="btn-floating btn-small waves-effect waves-light red" data-action="nested-form#remove">
        <i class="material-icons">delete</i>
      </button>
    </div>
  </div>
  <div class="row">
    <div class="input-field col s6">
      <%= f.label :paid_at, class: 'active' %>
      <%= f.text_field :paid_at, class: 'datepicker', data: { controller: 'datepicker' }, value: (f.object.paid_at.strftime('%d/%m/%Y') if f.object.paid_at) %>
    </div>
  </div>
</div>