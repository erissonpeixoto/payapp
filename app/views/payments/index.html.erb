<% filters_active = params[:status_filter].present? || params[:category_id].present? || params[:period_start].present? || params[:period_end].present? %>

<div class="mx-auto max-w-2xl pb-20 sm:pb-0">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink">Pagamentos</h1>
      <p class="text-xs text-ink-faint"><%= pluralize(@payments.total_entries, "fechamento") %></p>
    </div>
    <%= link_to "Novo fechamento", new_payment_path, class: "hidden items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint sm:inline-flex" %>
  </div>

  <%= form_tag payments_path, method: :get, class: "mb-6" do %>
    <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:items-center">
      <%= select_tag :status_filter,
          options_for_select(Payment.statuses.keys, params[:status_filter]),
          { include_blank: "Status", class: "h-auto w-full rounded-full border border-line bg-paper-raised px-3 py-1.5 text-xs font-medium text-ink-soft focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent sm:inline-block sm:w-auto sm:shrink-0" } %>
      <%= select_tag :category_id,
          options_from_collection_for_select(Category.where(user: current_user).order(:name), :id, :name, params[:category_id]),
          { include_blank: "Categoria", class: "h-auto w-full rounded-full border border-line bg-paper-raised px-3 py-1.5 text-xs font-medium text-ink-soft focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent sm:inline-block sm:w-auto sm:shrink-0" } %>
    </div>
    <% calendar_icon = capture do %>
      <svg class="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path stroke-linecap="round" d="M3 10h18M8 3v4M16 3v4" />
      </svg>
    <% end %>
    <%# iOS Safari doesn't draw a calendar glyph or a "dd/mm/aaaa" placeholder for
        an empty <input type="date"> the way Chrome does -- without this, the
        field looks like a blank, unlabeled box on iPhone. Kept narrower than
        the grid/flex would otherwise stretch them to (w-28 on mobile) so
        there's slack between the two: Safari's native
        calendar-picker-indicator can render wider than the input's own box,
        and with no slack that bleeds into the neighboring field. %>
    <div class="mt-2 flex flex-wrap gap-2 sm:mt-0 sm:items-center">
      <div class="relative w-28 sm:w-36">
        <%= calendar_icon %>
        <%= date_field_tag :period_start, params[:period_start],
            class: "h-auto w-full rounded-full border border-line bg-paper-raised py-1.5 pl-8 pr-3 text-xs font-medium text-ink-soft focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      </div>
      <div class="relative w-28 sm:w-36">
        <%= calendar_icon %>
        <%= date_field_tag :period_end, params[:period_end],
            class: "h-auto w-full rounded-full border border-line bg-paper-raised py-1.5 pl-8 pr-3 text-xs font-medium text-ink-soft focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      </div>
    </div>
    <div class="mt-2 flex items-center gap-3">
      <button type="submit" class="w-full rounded-full bg-accent px-3 py-1.5 text-xs font-semibold text-accent-contrast hover:bg-accent-tint sm:w-auto">Aplicar filtros</button>
      <% if filters_active %>
        <%= link_to "Limpar filtros", payments_path, class: "shrink-0 text-xs font-medium text-ink-faint hover:text-ink hover:underline" %>
      <% end %>
    </div>
  <% end %>

  <% if @payments.any? %>
    <div class="space-y-3">
      <% @payments.each do |payment| %>
        <%= link_to payment, class: "block" do %>
          <article class="rounded-lg border border-line bg-paper-raised p-4 shadow-sm hover:border-line-strong">
            <div class="mb-2 flex items-start justify-between gap-3">
              <div>
                <p class="font-display text-base font-semibold text-ink"><%= ledger_month_label(payment.payday) %></p>
                <p class="text-xs text-ink-faint"><%= ledger_period_label(payment.payday) %></p>
              </div>
              <%= badges(payment.status) %>
            </div>
            <div class="flex items-center justify-between gap-3">
              <div class="flex gap-3 text-xs text-ink-soft">
                <span class="inline-flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-expense"></span>
                  <%= pluralize(payment.expense_payments.size, "despesa") %>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-revenue"></span>
                  <%= pluralize(payment.revenue_payments.size, "receita") %>
                </span>
              </div>
              <% net = payment_net(payment) %>
              <p class="font-mono text-base font-semibold tabular-nums <%= net < 0 ? 'text-expense' : 'text-revenue' %>">
                <%= net < 0 ? "−" : "+" %><%= number_to_currency(net.abs, unit: "R$ ", separator: ",", delimiter: ".") %>
              </p>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>

    <div class="mt-4"><%= will_paginate @payments, renderer: "TailwindPaginationRenderer" %></div>
  <% else %>
    <%= render "shared/empty_state", title: "Nenhum fechamento registrado ainda." %>
  <% end %>
</div>

<%= link_to new_payment_path,
    class: "fixed bottom-6 right-6 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-accent-contrast shadow-md hover:bg-accent-tint sm:hidden",
    "aria-label": "Novo fechamento" do %>
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
    <path stroke-linecap="round" d="M12 5v14M5 12h14" />
  </svg>
<% end %>
