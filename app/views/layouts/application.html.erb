<!DOCTYPE html>
<html>
  <head>
    <script>
      // Runs before any CSS paints to avoid a flash of the wrong theme.
      // The actual toggle lives in app/javascript/controllers/theme_controller.js.
      (function () {
        var stored = localStorage.getItem("theme");
        if (stored) document.documentElement.dataset.theme = stored;
      })();
    </script>
    <title>Payapp</title>
    <%= csrf_meta_tags %>
    <%# Materialize (unlayered globals wrapped in @layer materialize) must load
        before Tailwind so that layer -- which CSS ranks by first-seen order --
        registers with the lowest priority; otherwise its bare `nav`, `a`, etc.
        selectors would beat every Tailwind utility regardless of specificity. %>
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'materialize_and_charts', 'data-turbo-track': 'reload' %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!--Let browser know website is optimized for mobile-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <%= favicon_link_tag asset_path('favicon_money.ico') %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink">
    <% if user_signed_in? %>
      <%= render 'layouts/nav' %>

      <div class="container flex-1">
        <%= render 'layouts/flash' %>
        <%= yield %>
      </div>

      <footer class="border-t border-line bg-paper-sunken">
        <div class="mx-auto max-w-5xl px-4 py-4 text-xs text-ink-faint">
          © 2018 GOEP SOFTWARE
        </div>
      </footer>

    <% else %>
      <%= render 'layouts/flash' %>
      <%= yield %>
    <% end %>
  </body>
</html>
