<div class="mx-auto max-w-2xl">
  <%= render "shared/back_header", title: "Editar conta", back_path: root_path %>

  <%= render "shared/form_errors", record: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="mt-1 text-xs text-ink-faint">Aguardando confirmação para: <%= resource.unconfirmed_email %></p>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "Nova senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.password_field :password, autocomplete: "new-password",
          class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      <p class="mt-1 text-xs text-ink-faint">
        Deixe em branco se não quiser alterar<% if @minimum_password_length %> (mínimo de <%= @minimum_password_length %> caracteres)<% end %>
      </p>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, "Confirme a nova senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
    </div>

    <div class="mb-6">
      <%= f.label :current_password, "Senha atual", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.password_field :current_password, autocomplete: "current-password",
          class: "w-full max-w-sm rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      <p class="mt-1 text-xs text-ink-faint">Necessária para confirmar qualquer alteração acima</p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "Cancelar", root_path, class: "rounded-md border border-line-strong px-4 py-2 text-sm font-medium text-ink hover:bg-paper-sunken" %>
      <%= f.submit "Salvar alterações", class: "cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint" %>
    </div>
  <% end %>

  <div class="mt-10 border-t border-line pt-6">
    <p class="mb-2 text-sm font-medium text-ink">Encerrar conta</p>
    <p class="mb-3 text-sm text-ink-soft">Isso apaga sua conta e todos os seus dados permanentemente.</p>
    <%= button_to "Excluir minha conta", registration_path(resource_name),
        method: :delete,
        data: { turbo_confirm: "Excluir sua conta e todos os seus dados? Essa ação não pode ser desfeita." },
        class: "cursor-pointer rounded-md border border-expense-tint/40 px-4 py-2 text-sm font-medium text-expense hover:bg-expense-tint/10" %>
  </div>
</div>
