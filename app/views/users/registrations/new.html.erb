<div class="rounded-lg border border-line bg-paper-raised p-6 shadow-sm">
  <h1 class="mb-6 text-center font-display text-xl font-semibold text-ink">Criar conta</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "Senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.password_field :password, autocomplete: "new-password",
          class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-ink-faint">Mínimo de <%= @minimum_password_length %> caracteres</p>
      <% end %>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, "Confirme a senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "w-full rounded-md border border-line-strong bg-paper-raised px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
    </div>

    <%= f.submit "Criar conta", class: "w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-contrast hover:bg-accent-tint" %>
  <% end %>

  <%= render "users/shared/links" %>
</div>
